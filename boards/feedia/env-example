# Every environment variable of Feedia BBS, with its default. On the server the
# secret (the webhook) goes in .env beside compose.yaml, never in the repository.

# rubbs
BBS_PORT=2323
BBS_MAX_SESSIONS=50

# The feed list, and the board's database (the admins' inbox of before the network's feedback)
FEEDIA_BBS_FEEDS=config/feeds.yml
FEEDIA_BBS_DB=data/feedia.sqlite3

# The network's Central (TTG Gate BBS): feedback and the wall live there. The secret is every board's.
TTG_CENTRAL_URL=http://ttg-gate-bbs:8090
RUBBS_AUTH_SECRET=
