# Every environment variable of Feedia, with its default. On the server the
# secret (the webhook) goes in .env beside compose.yaml, never in the repository.

# rubbs
BBS_PORT=2323
BBS_MAX_SESSIONS=100

# The feed list, and the inbox file that keeps suggestions and feedback
FEEDIA_FEEDS=config/feeds.yml
FEEDIA_INBOX=data/inbox.jsonl

# Suggestions and feedback ring this Discord webhook too; without it they only go to data/inbox.jsonl.
FEEDIA_DISCORD_WEBHOOK=
