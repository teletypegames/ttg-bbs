# Every environment variable of Feedia BBS, with its default. On the server the
# secret (the webhook) goes in .env beside compose.yaml, never in the repository.

# rubbs
BBS_PORT=2323
BBS_MAX_SESSIONS=50

# The feed list, and the board's database (the admins' inbox)
FEEDIA_BBS_FEEDS=config/feeds.yml
FEEDIA_BBS_DB=data/feedia.sqlite3

# Suggestions and feedback ring this Discord webhook too; without it they are only kept in the database.
FEEDIA_BBS_DISCORD_WEBHOOK=
