#!/usr/bin/env ruby
# frozen_string_literal: true

# The tests of the domain (minitest): test/**/*_test.rb.
#
#   bin/test                  all of them
#   bin/test wall canvas      the files whose name has one of the words

require 'bundler/setup'

ROOT = File.expand_path('..', __dir__)
$LOAD_PATH.unshift(File.join(ROOT, 'test'), File.join(ROOT, 'lib'))
files = Dir[File.join(ROOT, 'test/**/*_test.rb')]
files = files.select { |f| ARGV.any? { |w| File.basename(f).include?(w) } } if ARGV.any?
ARGV.clear
require 'minitest/autorun'
files.each { |f| require f }
