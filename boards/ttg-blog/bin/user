#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'

# The editors of the blog, from the server's shell:
#   docker exec -it ttg-blog-bbs bin/user list
#   docker exec -it ttg-blog-bbs bin/user add NAME      (asks the password twice; without a tty, two lines of stdin)
#   docker exec -it ttg-blog-bbs bin/user passwd NAME
#   docker exec -it ttg-blog-bbs bin/user remove NAME   (their posts stay, without an author)
require 'io/console'
require_relative '../lib/domain'

def ask(prompt) = $stdin.tty? ? $stdin.getpass(prompt) : $stdin.gets.to_s.chomp

def password
  first  = ask('password: ')
  second = ask('again: ')
  abort 'the two passwords differ' unless first == second
  first
end

BBS.config.env_prefix = 'TTG_BLOG_BBS_'
editors = TTGBlogBBS.new.editors
command, name = ARGV
result = case command
         when 'list'   then editors.all.each { |u| puts u.name } && :ok
         when 'add'    then name ? editors.add(name, password) : :usage
         when 'passwd' then name ? editors.set_password(name, password) : :usage
         when 'remove' then name ? editors.remove(name) : :usage
         else :usage
         end
case result
when :ok then puts 'ok' unless command == 'list'
when :usage then abort 'usage: bin/user list | add NAME | passwd NAME | remove NAME'
when :bad_name then abort "a name is 2 to #{EditorService::MAX_NAME} letters, digits, _ . -"
when :short_password then abort "a password is at least #{EditorService::MIN_PASS} characters"
when :taken then abort 'that name is taken'
when :no_user then abort 'no such editor'
end
