# Every environment variable of Siliconia BBS, with its default. Secrets go in the stack's .env on the
# server, never here.

# rubbs
BBS_PORT=2323
BBS_MAX_SESSIONS=50

# The catalog: the seed that ships with the board, the copy a refresh writes, and the seconds
# after which the board reads Wikidata again (0: never)
SILICONIA_BBS_CATALOG_SEED=config/catalog.json.gz
SILICONIA_BBS_CATALOG=data/catalog.json.gz
SILICONIA_BBS_CATALOG_TTL=604800

# The Legends shelf, kept by hand
SILICONIA_BBS_LEGENDS=config/legends.yml

# The Wikipedia leads kept in memory
SILICONIA_BBS_WIKIPEDIA_CACHE=200

# The callers' marks, memories and views
SILICONIA_BBS_DB=data/siliconia.sqlite3

# The Commons photos made small for both faces, one JSON a machine
SILICONIA_BBS_PICTURES=data/pictures

# The machine of the week, read by TTG Gate BBS's Daily Herald
SILICONIA_BBS_HERALD=data/herald.json

# The network's Central (TTG Gate BBS): accounts, feedback and the wall live there. The secret is
# every board's, in .env on the server, never here.
TTG_CENTRAL_URL=http://ttg-gate-bbs:8090
RUBBS_AUTH_SECRET=
