#!/usr/bin/env ruby
# frozen_string_literal: true

# Generates the personal access code for a player name.
#
# Usage:
#   PLAYER_NAME=norman bin/generate_code

require_relative '../lib/impostor/code_generator'

name = ENV['PLAYER_NAME']

if name.nil? || name.strip.empty?
  warn 'Error: PLAYER_NAME environment variable is not set.'
  warn 'Usage: PLAYER_NAME=norman bin/generate_code'
  exit 1
end

name = name.strip.upcase

if name.length < Impostor::CodeGenerator::NAME_LEN
  warn "Error: PLAYER_NAME must be at least #{Impostor::CodeGenerator::NAME_LEN} characters long."
  exit 1
end

puts Impostor::CodeGenerator.encrypt(name)
