BOARDS_PATH=data/boards
MESSAGES_PATH=data/messages.dat
LAST_CALLERS_PATH=data/last_callers.csv
PROFILE_PATH=data/profiles.csv
ACCOUNTS_PATH=data/accounts.csv
ONELINERS_PATH=data/oneliners.csv
IMPOSTOR_SESSIONS_PATH=data/impostor_sessions.csv
# The FTP server of the File Library (anonymous, passive mode).
BBS_FTP_HOST=ftp.teletypegames.org
# Sysop names, comma-separated. Their accounts are created only with bin/account.
BBS_SYSOPS=
# Discord webhook for new board posts and sysop broadcasts; empty = off.
BBS_DISCORD_WEBHOOK=
BBS_PORT=2323
# SERMO's key to the shared model service (infra/llm), one of its LLM_API_KEYS.
SERMO_LLM_API_KEY=
# BBS_DESKTOP_ART — a single .ans/.ansi/.asc/.nfo/.txt file shown on the
# main screen, or a folder of them (a random one per call). Its folder is the
# ANSI Gallery. Defaults to data/art/teletype.ansi.
BBS_DESKTOP_ART=data/art/teletype.ansi
