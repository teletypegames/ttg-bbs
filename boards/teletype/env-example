# The board's database: members, calls, votes, profiles, the trivia scores, and the posts, oneliners
# and mail of before the network's wall and feedback (kept as the archive).
TELETYPE_BBS_DB=data/teletype.sqlite3
# The FTP server whose WARP folder gives the Commodore doors the size of each game (anonymous, passive mode).
TELETYPE_BBS_FTP_HOST=ftp.teletypegames.org
BBS_PORT=2323
# SERMO's key to the shared model service (infra/llm), one of its LLM_API_KEYS.
SERMO_LLM_API_KEY=
# The key of the BBS's own characters (Ra, the TTG Master); empty = SERMO's key.
TELETYPE_BBS_LLM_API_KEY=

# The accounts, the wall and the feedback of the network (on TTG Gate BBS, the Central): the secret
# every board shares (in .env on the server, never here); sysops are the accounts with the sysop role
RUBBS_AUTH_SECRET=
