# The board's database: accounts, posts, mail, calls, votes, profiles, the wall, the trivia scores.
TELETYPE_BBS_DB=data/teletype.sqlite3
# The FTP server whose WARP folder gives the Commodore doors the size of each game (anonymous, passive mode).
TELETYPE_BBS_FTP_HOST=ftp.teletypegames.org
# Sysop names, comma-separated. Their accounts are created only with bin/account.
TELETYPE_BBS_SYSOPS=
# Discord webhook for new board posts and sysop broadcasts; empty = off.
TELETYPE_BBS_DISCORD_WEBHOOK=
# The read-only IRC window: one connection, a fixed nick, it never speaks. Empty server = off.
TELETYPE_BBS_IRC_SERVER=irc.libera.chat
TELETYPE_BBS_IRC_PORT=6697
TELETYPE_BBS_IRC_CHANNEL=#teletypegames
TELETYPE_BBS_IRC_NICK=ttgbbs
# NickServ password of the nick (SASL); empty = no login.
TELETYPE_BBS_IRC_PASSWORD=
BBS_PORT=2323
# SERMO's key to the shared model service (infra/llm), one of its LLM_API_KEYS.
SERMO_LLM_API_KEY=
# The key of the BBS's own characters (Ra, the TTG Master); empty = SERMO's key.
TELETYPE_BBS_LLM_API_KEY=
