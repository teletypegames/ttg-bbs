#!/usr/bin/env ruby
# frozen_string_literal: true

# Create an account or reset its password from the server shell. This is the
# only way to create a sysop account (names in TELETYPE_BBS_SYSOPS cannot be
# registered over telnet):
#
#   docker exec -it teletype-bbs bin/account Tasi

require 'io/console'
require 'bundler/setup'
require 'bbs'
require_relative '../lib/domain/model/names'
require_relative '../lib/domain/model/password'
require_relative '../lib/domain/repository/database'
require_relative '../lib/domain/repository/account_repository'
require_relative '../lib/domain/service/login_guard'
require_relative '../lib/domain/service/account_service'

name = ARGV.first.to_s.strip
abort 'usage: bin/account NAME' if name.empty?
abort "invalid name: #{name}" unless AccountService.normalize_name(name) == name

def ask(prompt)
  return $stdin.getpass(prompt) if $stdin.tty?

  $stdin.gets.to_s.chomp
end

password = ask('Password: ')
abort 'the two passwords differ' unless password == ask('Again: ')

db = Database.open(ENV.fetch('TELETYPE_BBS_DB', 'data/teletype.sqlite3'))
case AccountService.new(AccountRepository.new(db)).set_password(name, password)
when :ok        then puts "#{name}: password set"
when :too_short then abort "at least #{AccountService::MIN_PASSWORD} characters"
end
