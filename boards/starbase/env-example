# Every environment variable of Starbase BBS, with its default. The board has no secrets.

# rubbs
BBS_PORT=2323
BBS_MAX_SESSIONS=50

# The catalog of series and episodes (Wikidata, CC0): the seed shipped with the image, the
# refreshed copy in data/, and how old it may get before the board reads Wikidata again (s).
STARBASE_BBS_CATALOG_SEED=config/catalog.json.gz
STARBASE_BBS_CATALOG=data/catalog.json.gz
STARBASE_BBS_CATALOG_TTL=604800

# The network's Central (TTG Gate BBS): feedback and the wall live there. The secret is every board's,
# in .env on the server, never here.
TTG_CENTRAL_URL=http://ttg-gate-bbs:8090
RUBBS_AUTH_SECRET=
