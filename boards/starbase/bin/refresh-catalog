#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'

# Reads the series, episodes and films from Wikidata now and writes them as a
# catalog file, by default the seed that ships with the board:
#   bin/refresh-catalog [path]          (default config/catalog.json.gz)
# The running board refreshes its own copy in data/ by itself.
require 'bbs'
require_relative '../lib/domain'

path    = ARGV.first || File.expand_path('../config/catalog.json.gz', __dir__)
records = begin
  WikidataRepository.new.records
rescue BBS::HTTP::Error => e
  abort "Wikidata did not answer (#{e.message}); nothing written"
end
abort 'Wikidata answered no episodes; nothing written' if records['episodes'].empty?

BBS::Snapshot.write(path, records, Time.now.utc, source: StarbaseBBS::SOURCE)
puts "#{records['series'].size} series, #{records['episodes'].size} episodes and films written to #{path}"
