#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'

# Reads the best known films from Wikidata now and writes them as a catalog
# file, by default the seed that ships with the board:
#   bin/refresh-catalog [path]          (default config/catalog.json.gz)
# The running board refreshes its own copy in data/ by itself.
require 'rubbs'
require_relative '../lib/domain'

path    = ARGV.first || File.expand_path('../config/catalog.json.gz', __dir__)
records = begin
  CatalogRepository.new.records
rescue Rubbs::Common::Web::HTTP::Error => e
  abort "Wikidata did not answer (#{e.message}); nothing written"
end
abort 'Wikidata answered no films; nothing written' if records['films'].empty?

Rubbs::Common::Storage::Snapshot.write(path, records, Time.now.utc, source: KinemaBBS::SOURCE)
puts "#{records['films'].size} films written to #{path}"
